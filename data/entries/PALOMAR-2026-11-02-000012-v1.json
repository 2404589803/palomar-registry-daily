    "related_formalizations": [
      {
        "identifier": "https://github.com/leanprover-community/mathlib4/blob/v4.35.0-rc3/Mathlib/NumberTheory/LucasPrimality.lean",
        "note": "Mathlib has lucas_primality and, in NumberTheory/Fermat.lean, pepin_primality for Fermat numbers. A search of Mathlib v4.35.0-rc3 found no statement of Proth's theorem, Pocklington's criterion or Brillhart, Lehmer and Selfridge's theorems, and nothing on the Goldbach conjecture. A web search of Mathlib pull requests on 2026-11-02 found none on these criteria; that search is not exhaustive. The proofs here do not use lucas_primality.",
        "relationship": "other"
      },
      {
        "identifier": "https://github.com/b-mehta/PrimeCert",
        "note": "PrimeCert by Bhavik Mehta and Kenny Lau proves Pocklington's test and pocklington3_test, the sufficient direction of a cube root variant with the same test on r^2 - 8s, with an extra parameter m and a primality certificate tactic. It proves primality only, so it does not give the if and only if of Saouter's Lemma 1, and it has no Proth test or Goldbach content. It was found after the code here was written; no code of it is used.",
        "relationship": "other"
      },
      {
        "identifier": "https://lean-lang.org/eval/problems/weak_goldbach/",
        "note": "States Helfgott's theorem as an open formalization challenge, with no proof in Lean. No Lean formalization of ternary Goldbach or of a numerical check of it was found. Palomar searches on 2026-11-02 for Saouter, Proth, Pocklington, Lucas and Brillhart returned no entries.",
        "relationship": "other"
      },
      {
        "identifier": "https://github.com/sthubbar/goldbach-lean/tree/main/entries/heathbrown1985",
        "note": "Proves Vinogradov's three primes theorem for large odd numbers, ineffectively, so it does not overlap this numerical range. No code is shared.",
        "relationship": "other"
      }
